# ==============================================================================
# GitLeague Production & Development Environment Variable Inventory
# ==============================================================================
# Classifications:
#   [PUBLIC]       Safe for client-side / Vite bundler (prefixed with VITE_)
#   [SERVER ONLY]  API service runtime configuration
#   [WORKER ONLY]  Background sync worker runtime configuration
#   [SECRET]       Sensitive cryptographic keys and OAuth client secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION [SERVER ONLY]
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Set TRUST_PROXY=true (or hop count 1) when deployed behind reverse proxy (Render, Railway, Nginx)
TRUST_PROXY=false
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND ORIGINS [SERVER ONLY]
# In production, provide comma-separated non-localhost origins (e.g. https://gitleague.vercel.app)
# Wildcard '*' is strictly forbidden when credentials/cookies are enabled.
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION [SERVER ONLY / WORKER ONLY]
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/gitleague

# ------------------------------------------------------------------------------
# 4. REDIS CONFIGURATION (Cache & BullMQ) [SERVER ONLY / WORKER ONLY]
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. GITHUB OAUTH CREDENTIALS [SERVER ONLY / SECRET]
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# ------------------------------------------------------------------------------
# 6. ENCRYPTION AT REST (AES-256-GCM) [SERVER ONLY / WORKER ONLY / SECRET]
# Must be at least 32 characters (64 hex characters recommended). Reject default in production.
# ------------------------------------------------------------------------------
TOKEN_ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 7. SESSION & COOKIE CONFIGURATION [SERVER ONLY]
# ------------------------------------------------------------------------------
COOKIE_NAME=gitleague_session
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_TTL_DAYS=30

# ------------------------------------------------------------------------------
# 8. RATE LIMITING [SERVER ONLY]
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ------------------------------------------------------------------------------
# 9. WORKER CONCURRENCY [WORKER ONLY]
# Number of simultaneous GitHub sync jobs processed per worker instance
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=5

# ------------------------------------------------------------------------------
# 10. FRONTEND VITE PUBLIC CONFIGURATION [PUBLIC]
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/api/v1
